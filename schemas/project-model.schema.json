{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifex.dev/schemas/project-model.schema.json",
  "title": "ARTIFEX Project Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "git", "artifacts", "entities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"$ref": "#/$defs/project"},
    "git": {"$ref": "#/$defs/git"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^(REQ-(F|NF)-[0-9]{3}|ADR-[A-Z0-9][A-Z0-9-]*-[0-9]{3}|INV-[0-9]{3}|M[0-9]{2}(-T[0-9]{2})?|(VAL|EVD|WAV|LES|IMP|CHG|ART|STG|INT|RSR|RBL)-[A-Z0-9][A-Z0-9-]*)$"
    },
    "nullableCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "lifecycle", "workflow_depth"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "lifecycle": {"enum": ["greenfield", "brownfield"]},
        "workflow_depth": {"enum": ["QUICK", "STANDARD", "DEEP"]}
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string"}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialized",
        "branch",
        "baseline_commit",
        "current_commit",
        "dirty",
        "remote_status",
        "remotes"
      ],
      "properties": {
        "initialized": {"type": "boolean"},
        "branch": {"type": ["string", "null"]},
        "baseline_commit": {"$ref": "#/$defs/nullableCommit"},
        "current_commit": {"$ref": "#/$defs/nullableCommit"},
        "dirty": {"type": ["boolean", "null"]},
        "remote_status": {"enum": ["CONFIGURED", "NONE"]},
        "remotes": {
          "type": "array",
          "items": {"$ref": "#/$defs/remote"}
        }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "commit", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/nullableCommit"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path",
        "status",
        "fingerprint",
        "depends_on",
        "provenance",
        "metadata"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["DRAFT", "REVIEW", "ACCEPTED", "STALE", "SUPERSEDED"]},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"type": "object"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "statement", "artifact_id", "depends_on"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "kind": {
          "enum": [
            "requirement",
            "assumption",
            "constraint",
            "capability",
            "interface",
            "invariant",
            "milestone",
            "task"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        }
      }
    }
  }
}
