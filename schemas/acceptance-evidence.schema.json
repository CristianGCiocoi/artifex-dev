{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifex.dev/schemas/acceptance-evidence.schema.json",
  "title": "ARTIFEX Canonical Acceptance Evidence 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "validator_id", "validator_version", "validator_kind", "claim", "outcome", "facts", "binding", "output", "recorded_at", "producer_id", "independent_of_executor", "entry_hash"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9-]*$", "maxLength": 128},
    "validator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
    "validator_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$", "maxLength": 64},
    "validator_kind": {"enum": ["DETERMINISTIC", "STRUCTURED_INSPECTION", "INDEPENDENT_AGENT", "MANUAL"]},
    "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
    "outcome": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "value": {"oneOf": [{"type": "string", "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]}}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["base_commit", "contract_hash", "project_model_fingerprints"], "properties": {"base_commit": {"type": "string", "minLength": 1, "maxLength": 128}, "contract_hash": {"type": "string", "minLength": 1, "maxLength": 128}, "project_model_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}}},
    "output": {"type": "string", "maxLength": 4000},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
    "independent_of_executor": {"type": "boolean"},
    "entry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
