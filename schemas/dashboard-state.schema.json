{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifex.local/schemas/dashboard-state.schema.json",
  "title": "ARTIFEX Dashboard State",
  "type": "object",
  "required": ["schema_version", "project", "milestones", "gates", "evidence", "traceability", "git"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["id", "name", "architecture_version", "implementation_plan_version"],
      "additionalProperties": true
    },
    "milestones": {"type": "array", "items": {"$ref": "#/$defs/milestone"}},
    "gates": {"$ref": "#/$defs/gateCounts"},
    "evidence": {
      "type": "object",
      "required": ["current", "stale"],
      "properties": {"current": {"type": "integer", "minimum": 0}, "stale": {"type": "integer", "minimum": 0}}
    },
    "traceability": {
      "type": "object",
      "required": ["requirements_total", "requirements_traced", "orphan_requirements"],
      "properties": {
        "requirements_total": {"type": "integer", "minimum": 0},
        "requirements_traced": {"type": "integer", "minimum": 0},
        "orphan_requirements": {"type": "integer", "minimum": 0}
      }
    },
    "git": {"type": "object", "required": ["commit", "dirty"], "additionalProperties": true}
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "required": ["id", "state", "completed_tasks", "total_tasks"],
      "properties": {
        "id": {"pattern": "^M[0-9]{2}$"},
        "state": {"enum": ["PLANNED", "READY", "ACTIVE", "BLOCKED", "IMPLEMENTED", "VERIFYING", "ACCEPTED", "SUPERSEDED"]},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "total_tasks": {"type": "integer", "minimum": 0},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gateCounts": {
      "type": "object",
      "required": ["pass", "fail", "blocked", "waived", "stale"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "waived": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0}
      }
    }
  }
}

