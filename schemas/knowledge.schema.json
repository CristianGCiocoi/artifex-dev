{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifex.dev/schemas/knowledge.schema.json",
  "title": "ARTIFEX Knowledge and Controlled Evolution",
  "oneOf": [
    {"$ref": "#/$defs/knowledgeItem"},
    {"$ref": "#/$defs/improvementProposal"},
    {"$ref": "#/$defs/updateAssessment"}
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^(LES|IMP)-[A-Z0-9][A-Z0-9-]*$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "artifact", "commit", "integration", "evidence_ids"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "artifact": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "integration": {"type": ["string", "null"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "anyOf": [
        {"properties": {"artifact": {"type": "string", "minLength": 1}}},
        {"properties": {"commit": {"type": "string", "minLength": 1}}},
        {"properties": {"integration": {"type": "string", "minLength": 1}}},
        {"properties": {"evidence_ids": {"minItems": 1}}}
      ]
    },
    "promotionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_targets", "minimum_confidence", "minimum_evidence", "maximum_sensitivity", "require_validation"],
      "properties": {
        "allowed_targets": {
          "type": "array",
          "items": {"enum": ["PROJECT", "INSTANCE"]},
          "uniqueItems": true
        },
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_evidence": {"type": "integer", "minimum": 1},
        "maximum_sensitivity": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"]},
        "require_validation": {"type": "boolean"}
      }
    },
    "verifiedAgainst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "fingerprint", "verified_at"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "revisitTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["ARTIFACT_CHANGED", "CORE_VERSION_CHANGED", "DATE_REACHED", "MANUAL"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "knowledgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "kind", "statement", "provenance", "confidence", "sensitivity", "promotion_policy", "verified_against", "revisit_triggers", "state", "project_id", "run_id", "promoted_from"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "scope": {"enum": ["CORE", "PROFILE", "INSTANCE", "PROJECT", "RUN", "HARNESS"]},
        "kind": {"enum": ["FACT", "ASSUMPTION", "DECISION", "PREFERENCE", "LESSON", "PATTERN"]},
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}, "minItems": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"]},
        "promotion_policy": {"$ref": "#/$defs/promotionPolicy"},
        "verified_against": {"type": "array", "items": {"$ref": "#/$defs/verifiedAgainst"}},
        "revisit_triggers": {"type": "array", "items": {"$ref": "#/$defs/revisitTrigger"}},
        "state": {"enum": ["CURRENT", "STALE", "SUPERSEDED"]},
        "project_id": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "promoted_from": {"type": ["string", "null"], "enum": ["CORE", "PROFILE", "INSTANCE", "PROJECT", "RUN", "HARNESS", null]}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "PROJECT"}}}, "then": {"properties": {"project_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"scope": {"const": "RUN"}}}, "then": {"properties": {"run_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"kind": {"const": "LESSON"}}}, "then": {"properties": {"id": {"pattern": "^LES-"}}}}
      ]
    },
    "improvementProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lesson_ids", "target", "reason", "expected_benefit", "evidence", "requested_privileges"],
      "properties": {
        "id": {"type": "string", "pattern": "^IMP-[A-Z0-9][A-Z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "lesson_ids": {"type": "array", "items": {"type": "string", "pattern": "^LES-"}, "minItems": 1, "uniqueItems": true},
        "target": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expected_benefit": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "requested_privileges": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "updateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "from_core_version", "to_core_version", "classification", "reason"],
      "properties": {
        "overlay_id": {"type": "string", "minLength": 1},
        "from_core_version": {"type": "string", "minLength": 1},
        "to_core_version": {"type": "string", "minLength": 1},
        "classification": {"enum": ["CARRY_FORWARD", "SUPERSEDED", "REVALIDATE", "CONFLICT"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
